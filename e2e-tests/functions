	local hugepages_source
	hugepages_source="data:text/plain;charset=utf-8;base64,$(printf 'vm.nr_hugepages = %s\n' "${hugepage_count}" | base64 | tr -d '\n')"

	HUGEPAGES_SOURCE="${hugepages_source}" yq \
