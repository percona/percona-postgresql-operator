function execute_curl() {
	local name="curl-${RANDOM}"
	local image="${CURL_IMAGE:-docker.io/alpine/curl:latest}"
	local phase=""
	local exit_status=0

	kubectl run "$name" \
		-n "$NAMESPACE" \
		--restart=Never \
		--image="$image" \
		--command -- curl -sS "$@" >/dev/null

	for _ in $(seq 1 60); do
		phase=$(kubectl get pod "$name" -n "$NAMESPACE" -o jsonpath='{.status.phase}' 2>/dev/null || true)
		if [[ $phase == "Succeeded" || $phase == "Failed" ]]; then
			break
		fi
		sleep 1
	done

	kubectl logs "$name" -n "$NAMESPACE" || exit_status=$?
	kubectl delete pod "$name" -n "$NAMESPACE" --ignore-not-found --wait=false >/dev/null 2>&1 || true

	if [[ $phase != "Succeeded" ]]; then
		return 1
	fi

	return $exit_status
}

function generate_pmm_server_token() {
	local key_name=$RANDOM
	local endpoint
	endpoint=$(get_service_ip monitoring-service)

	local ADMIN_PASSWORD
	ADMIN_PASSWORD=$(kubectl -n "${NAMESPACE}" get secret pmm-secret -o jsonpath="{.data.PMM_ADMIN_PASSWORD}" | base64 --decode)

	if [[ -z $ADMIN_PASSWORD ]]; then
		echo "Error: ADMIN_PASSWORD is empty or not found!" >&2
		return 1
	fi

	local create_response create_status_code create_json_response
	create_response=$(execute_curl \
		--insecure \
		--silent \
		--request POST \
		--header 'Content-Type: application/json' \
		--header 'Accept: application/json' \
		--data "{\"name\":\"${key_name}\", \"role\":\"Admin\", \"isDisabled\":false}" \
		--user "admin:${ADMIN_PASSWORD}" \
		--write-out '\n%{http_code}' \
		"https://${endpoint}/graph/api/serviceaccounts")

	create_status_code=$(echo "$create_response" | tail -n1)
	create_json_response=$(echo "$create_response" | $sed '$ d')

	if [[ $create_status_code -ne 201 ]]; then
		echo "Error: Failed to create PMM service account. HTTP Status: $create_status_code" >&2
		echo "Response: $create_json_response" >&2
		return 1
	fi

	local service_account_id
	service_account_id=$(echo "$create_json_response" | jq -r '.id')

	if [[ -z $service_account_id || $service_account_id == "null" ]]; then
		echo "Error: Failed to extract service account ID!" >&2
		return 1
	fi

	local token_response token_status_code token_json_response
	token_response=$(execute_curl \
		--insecure \
		--silent \
		--request POST \
		--header 'Content-Type: application/json' \
		--data "{\"name\":\"${key_name}\"}" \
		--user "admin:${ADMIN_PASSWORD}" \
		--write-out '\n%{http_code}' \
		"https://${endpoint}/graph/api/serviceaccounts/${service_account_id}/tokens")

	token_status_code=$(echo "$token_response" | tail -n1)
	token_json_response=$(echo "$token_response" | $sed '$ d')

	if [[ $token_status_code -ne 200 ]]; then
		echo "Error: Failed to create token. HTTP Status: $token_status_code" >&2
		echo "Response: $token_json_response" >&2
		return 1
	fi

	echo "$token_json_response" | jq -r '.key'
}

function get_metric_values() {
	local metric=$1
	local instance=$2
	local token=$3
	local start=$($date -u "+%s" -d "-5 minute")
	local end=$($date -u "+%s")
	local endpoint=$(get_service_ip monitoring-service)

	local wait_count=20
	local retry=0
	until [[ $(execute_curl -s -k -H "Authorization: Bearer ${token}" "https://$endpoint/graph/api/datasources/proxy/1/api/v1/query_range?query=min%28$metric%7Bnode_name%3D%7E%22$instance%22%7d%20or%20$metric%7Bnode_name%3D%7E%22$instance%22%7D%29&start=$start&end=$end&step=60" \
		| jq '.data.result[0].values[][1]' \
		| grep '^"[0-9]') ]]; do
		sleep 2
		local start=$($date -u "+%s" -d "-5 minute")
		local end=$($date -u "+%s")
		let retry+=1
		if [[ $retry -ge $wait_count ]]; then
			exit 1
		fi
	done
}

function get_qan20_values() {
	local token=$2
	local endpoint=$(get_service_ip monitoring-service)
	local period_start_from=$($date -u -d '-12 hour' '+%Y-%m-%dT%H:%M:%S%:z')
	local period_start_to=$($date -u '+%Y-%m-%dT%H:%M:%S%:z')
	local payload

	payload=$(jq \
		--arg period_start_from "${period_start_from}" \
		--arg period_start_to "${period_start_to}" \
		'.period_start_from = $period_start_from | .period_start_to = $period_start_to' \
		"${TEST_CONFIG_DIR}/qan20-payload.json")

	execute_curl -s -k -H "Authorization: Bearer ${token}" -XPOST -d "${payload}" \
		"https://$endpoint/v1/qan/metrics:getReport" \
		| jq '.rows[].sparkline'
}

