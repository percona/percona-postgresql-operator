function apply_hugepages_daemonset() {
	local hugepage_count=$1
	local node_service=$2
	local manifest="${TEST_CONFIG_DIR}/huge-pages-daemonset.yaml"
	local expression='(.spec.template.spec.containers[] | select(.name == "hugepages") | .env[] | select(.name == "HUGEPAGE_COUNT") | .value) = strenv(HUGEPAGE_COUNT) |
		(.spec.template.spec.containers[] | select(.name == "hugepages") | .env[] | select(.name == "NODE_SERVICE") | .value) = strenv(NODE_SERVICE)'

	HUGEPAGE_COUNT="${hugepage_count}" NODE_SERVICE="${node_service}" \
		yq "${expression}" "${manifest}" \
		| kubectl apply -f -
}

function configure_hugepages_on_labeled_nodes() {
	local platform=$1
	local hugepage_count=$2
	local node_service=$3
	local rollout_timeout=${4:-15m}

	apply_hugepages_daemonset "${hugepage_count}" "${node_service}"

	kubectl -n kube-system rollout status daemonset/hugepages --timeout="${rollout_timeout}" || {
		echo "${platform}: Hugepages DaemonSet rollout did not complete"
		return 1
	}

	for _ in {1..60}; do
		if verify_hugepages_on_labeled_nodes; then
			echo "Hugepages successfully configured on ${platform} nodes"
			return 0
		fi
		sleep 5
	done

	echo "${platform}: Hugepages capacity was not published by kubelet"
	return 1
}

function verify_hugepages_on_labeled_nodes() {
	local nodes
	nodes=$(kubectl get nodes -l hugepages=enabled -o name 2>/dev/null)

	if [ -z "${nodes}" ]; then
		echo "No nodes labeled with hugepages=enabled found"
		return 1
	fi

	local node allocatable
	for node in ${nodes}; do
		allocatable=$(kubectl get "${node}" -o jsonpath='{.status.allocatable.hugepages-2Mi}')
		if [ -z "${allocatable}" ] || [ "${allocatable}" = "0" ]; then
			echo "No allocatable hugepages found on ${node}"
			return 1
		fi
		echo "${node} has allocatable hugepages: ${allocatable}"
	done
}

function enable_hugepages_gke() {
	echo "Hugepages configuration is handled during GKE cluster creation"
	verify_hugepages_on_nodes
}

function enable_hugepages_eks() {
	echo "Verifying hugepages on EKS"
	verify_hugepages_on_nodes
}

function enable_hugepages_doks() {
