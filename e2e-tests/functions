		psql -v ON_ERROR_STOP=1 -t -q "${driver}://${uri}" -c "${command}"
}

# Fail unless pg_tde_key_info() contains global-master-key-<PostgresCluster metadata.uid>.
function assert_pg_tde_key_info_uid() {
	local uri=${1}
	local cluster=${2}

	local uid
	uid=$(kubectl -n "${NAMESPACE}" get postgrescluster "${cluster}" -o jsonpath='{.metadata.uid}')

	echo "Showing TDE key info"
	local key_info
	key_info=$(run_psql_command "SELECT pg_tde_key_info();" "${uri}")
	echo "${key_info}"

	if [[ ${key_info} != *"global-master-key-${uid}"* ]]; then
		echo "TDE key does not contain PostgresCluster ${cluster} uid ${uid}: ${key_info}"
		exit 1
	fi
}

