function wait_pg_condition() {
	local cluster="$1"
	local condition="$2"
	local expected_status="$3"
	local expected_reason="$4"
	local expected_message="$5"
	local expected_generation="$6"
	local timeout_seconds="${7:-0}"
	local interval="${8:-5}"
	local namespace="${9:-$NAMESPACE}"
	local status=""
	local reason=""
	local message=""
	local generation=""
	local json=""
	local elapsed=0

	until [[ ${status} == "${expected_status}" ]] && [[ ${reason} == "${expected_reason}" ]] && [[ ${message} == "${expected_message}" ]] && [[ ${generation} == "${expected_generation}" ]]; do
		json=$(kubectl -n "${namespace}" get pg "${cluster}" -o json || true)
		status=$(printf '%s' "${json}" | jq -r ".status.conditions[]? | select(.type == \"${condition}\") | .status")
		reason=$(printf '%s' "${json}" | jq -r ".status.conditions[]? | select(.type == \"${condition}\") | .reason")
		message=$(printf '%s' "${json}" | jq -r ".status.conditions[]? | select(.type == \"${condition}\") | .message")
		generation=$(printf '%s' "${json}" | jq -r ".status.conditions[]? | select(.type == \"${condition}\") | .observedGeneration")

		echo "Waiting state: pg/${cluster} condition=${condition}"
		echo "expected: status=${expected_status} reason=${expected_reason} generation=${expected_generation} message=${expected_message}"
		echo "current: status=${status} reason=${reason} generation=${generation} message=${message}"

		if ((timeout_seconds > 0 && elapsed >= timeout_seconds)); then
			echo "timeout waiting for condition ${condition} expected status=${expected_status} reason=${expected_reason} generation=${expected_generation} on pg/${cluster} after ${timeout_seconds}s"
			echo "expected message: ${expected_message}"
			echo "--- pg conditions ---"
			kubectl -n "${namespace}" get pg "${cluster}" -o jsonpath='{range .status.conditions[*]}{.type}{"|"}{.status}{"|"}{.reason}{"|"}{.observedGeneration}{"|"}{.message}{"\n"}{end}' || true
			echo "--- pg describe ---"
			kubectl -n "${namespace}" describe pg "${cluster}" || true
			echo "--- recent events ---"
			kubectl -n "${namespace}" get events --sort-by=.lastTimestamp | tail -n 80 || true
			return 1
		fi

		sleep "${interval}"
		elapsed=$((elapsed + interval))
	done

	echo "${cluster} ${condition} reached expected values: status=${status} reason=${reason} generation=${generation}"
}

function assert_configmap_data() {
