	kubectl delete clusterrolebinding monitoring --ignore-not-found
	helm repo add percona https://percona.github.io/percona-helm-charts/
	helm repo update

	if [[ ${PLATFORM} == "openshift" ]]; then
		oc create sa pmm-server -n "$NAMESPACE"
