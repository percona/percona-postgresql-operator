	fi
}

function assert_tde_state() {
	local cluster="$1"
	local is_standby="${2:-false}"
	local pgversion primary replica check_pod
	local pod annotation target archive_command restore_command conf instance_conf
	local wal_encrypt current repo_name

	pgversion=$(kubectl -n "${NAMESPACE}" get pg "${cluster}" -o jsonpath='{.spec.postgresVersion}')
	primary=$(kubectl -n "${NAMESPACE}" get pods --selector="postgres-operator.crunchydata.com/role=primary,postgres-operator.crunchydata.com/cluster=${cluster}" -o jsonpath='{.items[0].metadata.name}')
	check_pod="${primary}"

	if [[ ${is_standby} != "true" ]]; then
		replica=$(kubectl -n "${NAMESPACE}" get pods --selector="postgres-operator.crunchydata.com/role=replica,postgres-operator.crunchydata.com/cluster=${cluster}" -o jsonpath='{.items[0].metadata.name}')
	fi

	wal_encrypt=$(kubectl -n "${NAMESPACE}" exec "${check_pod}" -c database -- psql -t -A -c 'SHOW pg_tde.wal_encrypt;')
	if [[ ${wal_encrypt} != "on" ]]; then
		echo "Waiting state: pg_tde.wal_encrypt pod=${check_pod}; expected: value=on; current: value=${wal_encrypt}"
		return 1
	fi

	for pod in $(kubectl -n "${NAMESPACE}" get pods -o name \
		--selector="postgres-operator.crunchydata.com/cluster=${cluster},postgres-operator.crunchydata.com/data=postgres"); do
		annotation=$(kubectl -n "${NAMESPACE}" get "${pod}" -o yaml | yq '.metadata.annotations."pgv2.percona.com/tde-wal-encryption"')
		if [[ ${annotation} != "true" ]]; then
			echo "Waiting state: WAL encryption annotation pod=${pod}; expected: value=true; current: value=${annotation}"
			return 1
		fi

		target=$(kubectl -n "${NAMESPACE}" exec "${pod}" -c database -- readlink /pgdata/pg_tde)
		if [[ ${target} != "/pgdata/pg${pgversion}/pg_tde" ]]; then
			echo "Waiting state: pg_tde keyring link pod=${pod}; expected: target=/pgdata/pg${pgversion}/pg_tde; current: target=${target}"
			return 1
		fi
		if ! kubectl -n "${NAMESPACE}" exec "${pod}" -c database -- test -d /pgdata/pg_tde; then
			echo "Waiting state: pg_tde keyring path pod=${pod}; expected: path=/pgdata/pg_tde exists; current: path=/pgdata/pg_tde does not exist"
			return 1
		fi
	done

	if [[ ${is_standby} == "true" ]]; then
		# Standby leader is labeled primary but stays in recovery, so restore_command is set there.
		restore_command=$(kubectl -n "${NAMESPACE}" exec "${primary}" -c database -- psql -t -A -c 'SHOW restore_command;')
		if [[ ${restore_command} != *'pg_tde_restore_encrypt %f %p '* ]]; then
			echo "Waiting state: restore_command wrapper pod=${primary}; expected: contains=pg_tde_restore_encrypt %f %p; current: value=${restore_command}"
			return 1
		fi
		repo_name=$(kubectl -n "${NAMESPACE}" get pg "${cluster}" -o jsonpath='{.spec.standby.repoName}')
		if [[ -n ${repo_name} && ${restore_command} != *"--repo=${repo_name#repo}"* ]]; then
			echo "Waiting state: restore_command repository pod=${primary}; expected: contains=--repo=${repo_name#repo}; current: value=${restore_command}"
			return 1
		fi
	else
		archive_command=$(kubectl -n "${NAMESPACE}" exec "${primary}" -c database -- psql -t -A -c 'SHOW archive_command;')
		if [[ ${archive_command} != 'pg_tde_archive_decrypt %f %p "pgbackrest --stanza=db archive-push %%p"'* ]]; then
			echo "Waiting state: archive_command wrapper pod=${primary}; expected: starts-with=pg_tde_archive_decrypt %f %p \"pgbackrest --stanza=db archive-push %%p\"; current: value=${archive_command}"
			return 1
		fi

		if [[ ${archive_command} != *'pg_tde_waldump'* ]]; then
			echo "Waiting state: archive_command WAL inspection pod=${primary}; expected: contains=pg_tde_waldump; current: value=${archive_command}"
			return 1
		fi

		# restore_command is applied on replicas (primary SHOW is empty once settled)
		restore_command=$(kubectl -n "${NAMESPACE}" exec "${replica}" -c database -- psql -t -A -c 'SHOW restore_command;')
		if [[ ${restore_command} != *'pg_tde_restore_encrypt %f %p '* ]]; then
			echo "Waiting state: restore_command wrapper pod=${replica}; expected: contains=pg_tde_restore_encrypt %f %p; current: value=${restore_command}"
			return 1
		fi
	fi

	for key in pgbackrest_instance.conf pgbackrest_repo.conf; do
		conf=$(kubectl get -n "${NAMESPACE}" cm "${cluster}-pgbackrest-config" -o yaml | yq '.data."'"${key}"'"')
		if ! echo "${conf}" | grep -q '^checksum-page = n$'; then
			current=$(echo "${conf}" | grep '^checksum-page' || true)
			echo "Waiting state: checksum-page config=${key}; expected: value=checksum-page = n; current: value=${current:-<missing>}"
			return 1
		fi
	done

	instance_conf=$(kubectl get -n "${NAMESPACE}" cm "${cluster}-pgbackrest-config" -o yaml | yq '.data."pgbackrest_instance.conf"')
	if ! echo "${instance_conf}" | grep -q '^archive-async = n$'; then
		current=$(echo "${instance_conf}" | grep '^archive-async' || true)
		echo "Waiting state: archive-async config=pgbackrest_instance.conf; expected: value=archive-async = n; current: value=${current:-<missing>}"
		return 1
	fi

	return 0
}

function assert_standby_promotion() {
	local cluster="$1"
	local namespace="${2:-$NAMESPACE}"
	local primary in_recovery patroni_list

	# role=primary, spec.standby.enabled=false and status.state=ready are not
	# proof of promotion: a Standby Leader keeps the primary label and can be
	# ready while still in recovery. pg_is_in_recovery() is the Postgres signal.
	primary=$(kubectl -n "${namespace}" get pods --selector="postgres-operator.crunchydata.com/role=primary,postgres-operator.crunchydata.com/cluster=${cluster}" -o jsonpath='{.items[0].metadata.name}')

	in_recovery=$(kubectl -n "${namespace}" exec "${primary}" -c database -- psql -t -A -c 'SELECT pg_is_in_recovery();')
	if [[ ${in_recovery} != "f" ]]; then
		echo "Primary ${primary} is still in recovery: ${in_recovery}"
		return 1
	fi

	patroni_list=$(kubectl -n "${namespace}" exec "${primary}" -c database -- patronictl list)
	if echo "${patroni_list}" | grep -q 'Standby Leader'; then
		echo "Patroni still reports Standby Leader:"
		echo "${patroni_list}"
		return 1
	fi
	if ! echo "${patroni_list}" | grep -q '| Leader  |'; then
		echo "Patroni does not report a Leader:"
		echo "${patroni_list}"
		return 1
	fi

	return 0
}

function deploy_pmm_server() {
