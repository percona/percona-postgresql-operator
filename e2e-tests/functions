function chaos_daemon_exec_in_pod_netns() {
	local ns=$1
	local pod=$2
	local container=$3
	local node
	local container_id
	local daemon
	shift 3

	node=$(kubectl get pod "${pod}" --namespace "${ns}" -o jsonpath='{.spec.nodeName}')
	container_id=$(kubectl get pod "${pod}" --namespace "${ns}" -o json \
		| jq -r --arg container "${container}" '.status.containerStatuses[] | select(.name == $container) | .containerID' \
		| cut -d/ -f3)
	daemon=$(kubectl get pod --namespace "${ns}" \
		--selector='app.kubernetes.io/component=chaos-daemon' \
		--field-selector="spec.nodeName=${node}" \
		-o jsonpath='{.items[0].metadata.name}')

	# Find the target container's network namespace and run the command there.
	# Ignore the host namespace so iptables changes affect only the target Pod.
	# The variables in this script are expanded inside the chaos-daemon container.
	# shellcheck disable=SC2016
	kubectl exec --namespace "${ns}" "${daemon}" -- sh -eu -c '
		host_netns=$(readlink /proc/1/ns/net)
		netns=""
		for cgroup in $(grep -l "$1" /proc/[0-9]*/cgroup 2>/dev/null); do
			candidate=${cgroup%/cgroup}/ns/net
			if [ -e "$candidate" ] && [ "$(readlink "$candidate")" != "$host_netns" ]; then
				netns="$candidate"
				break
			fi
		done

		if [ -z "$netns" ]; then
			netns=$(grep -l "$1" /proc/[0-9]*/cgroup 2>/dev/null | tail -n1)
			netns=${netns%/cgroup}/ns/net
		fi
		shift
		exec nsexec --net "$netns" "$@"
	' sh "${container_id}" "$@"
}

function network_block_storage_endpoint() {
	local ns=$1
	local primary=$2
	local endpoint=$3
	local container="${4:-database}"

	chaos_daemon_exec_in_pod_netns "${ns}" "${primary}" "${container}" \
		iptables -I OUTPUT 1 -p tcp --dport 443 \
		-m string --algo bm --string "${endpoint}" \
		-m comment --comment pgo-e2e-block-storage \
		-j REJECT --reject-with tcp-reset

	sleep 5
}

function network_unblock_storage_endpoint() {
	local ns=$1
	local primary=$2
	local endpoint=$3
	local container="${4:-database}"

	chaos_daemon_exec_in_pod_netns "${ns}" "${primary}" "${container}" \
		iptables -D OUTPUT -p tcp --dport 443 \
		-m string --algo bm --string "${endpoint}" \
		-m comment --comment pgo-e2e-block-storage \
		-j REJECT --reject-with tcp-reset
}

function wait_deployment() {
	local name=$1
	local target_namespace=${2:-"$namespace"}

	sleep 10
	set +o xtrace
	retry=0
	echo -n $name
	until [ -n "$(kubectl -n ${target_namespace} get deployment $name -o jsonpath='{.status.replicas}')" \
		-a "$(kubectl -n ${target_namespace} get deployment $name -o jsonpath='{.status.replicas}')" \
		== "$(kubectl -n ${target_namespace} get deployment $name -o jsonpath='{.status.readyReplicas}')" ]; do
		sleep 1
		echo -n .
		let retry+=1
		if [ $retry -ge 360 ]; then
			kubectl logs $(get_operator_pod) -c operator \
				| grep -v 'level=info' \
				| grep -v 'level=debug' \
				| tail -100
			echo max retry count $retry reached. something went wrong with operator or kubernetes cluster
			exit 1
		fi
	done
	echo
	set -o xtrace
}

