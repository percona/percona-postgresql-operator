function ensure_rancher_hugepages_node() {
	local node
	node=$(kubectl get nodes -l node-role.kubernetes.io/worker \
		-o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)

	if [ -z "${node}" ]; then
		node=$(kubectl get nodes \
			-l '!node-role.kubernetes.io/master,!node-role.kubernetes.io/control-plane' \
			-o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
	fi

	if [ -z "${node}" ]; then
		echo "RKE2: No worker nodes found"
		return 1
	fi

	local labeled_node
	for labeled_node in $(kubectl get nodes -l hugepages=enabled -o name 2>/dev/null); do
		if [[ ${labeled_node} != "node/${node}" ]]; then
			kubectl label "${labeled_node}" hugepages-
		fi
	done

	kubectl label "node/${node}" hugepages=enabled --overwrite
	kubectl wait "node/${node}" --for=condition=Ready --timeout=15m
}

function ensure_doks_hugepages_nodepool() {
	local nodepool_name="${DOKS_HUGEPAGES_NODEPOOL:-hp2m}"
	local node_size="${DOKS_HUGEPAGES_NODE_SIZE:-s-4vcpu-16gb-amd}"
	local node_count="${DOKS_HUGEPAGES_NODE_COUNT:-1}"
	local cluster_name
	local nodepool_id
	local node_selector
	local nodes
	local actual_node_count=0
	cluster_name=$(get_k8s_cluster_name doks)

	if [ -z "${cluster_name}" ]; then
		echo "DOKS: Could not determine the cluster name"
		return 1
	fi

	if doctl kubernetes cluster node-pool get "${cluster_name}" "${nodepool_name}" >/dev/null 2>&1; then
		echo "DOKS node pool '${nodepool_name}' already exists"
	else
		echo "Creating DOKS node pool '${nodepool_name}' (${node_size}, count=${node_count})"
		doctl kubernetes cluster node-pool create "${cluster_name}" \
			--name "${nodepool_name}" \
			--size "${node_size}" \
			--count "${node_count}" \
			--label hugepages=enabled
	fi

	nodepool_id=$(doctl kubernetes cluster node-pool get \
		"${cluster_name}" "${nodepool_name}" --output json \
		| jq -r 'if type == "array" then .[0].id else .id end')

	if [ -z "${nodepool_id}" ] || [ "${nodepool_id}" == "null" ]; then
		echo "DOKS: Could not determine the ID of node pool '${nodepool_name}'"
		return 1
	fi

	node_selector="doks.digitalocean.com/node-pool-id=${nodepool_id}"

	for _ in {1..180}; do
		nodes=$(kubectl get nodes -l "${node_selector}" -o name 2>/dev/null)
		actual_node_count=$(printf '%s\n' "${nodes}" | awk 'NF { count++ } END { print count + 0 }')
		if [ "${actual_node_count}" -ge "${node_count}" ]; then
			break
		fi
		sleep 5
	done

	if [ "${actual_node_count}" -lt "${node_count}" ]; then
		echo "DOKS: Expected ${node_count} nodes from '${nodepool_name}', found ${actual_node_count}"
		return 1
	fi

	kubectl wait node -l "${node_selector}" --for=condition=Ready --timeout=15m

	local node current_nodepool_id
	for node in $(kubectl get nodes -l hugepages=enabled -o name 2>/dev/null); do
		current_nodepool_id=$(kubectl get "${node}" -o jsonpath='{.metadata.labels.doks\.digitalocean\.com/node-pool-id}')
		if [ "${current_nodepool_id}" != "${nodepool_id}" ]; then
			kubectl label "${node}" hugepages-
		fi
	done

	for node in ${nodes}; do
		kubectl label "${node}" hugepages=enabled --overwrite
	done
}

function ensure_aks_hugepages_nodepool() {
	local nodepool_name="${AKS_HUGEPAGES_NODEPOOL:-hp2m}"
	local vm_size="${AKS_HUGEPAGES_VM_SIZE:-Standard_D4_v2}"
	local node_count="${AKS_HUGEPAGES_NODE_COUNT:-1}"
	local subscription="${AZURE_SUBSCRIPTION:-eng-cloud-dev}"
	local resource_group="${AKS_RG:-percona-operators}"
	local cluster_name
	local node_rg
	local aks_id
	local provider_id

	provider_id="$(kubectl get nodes -o jsonpath='{.items[0].spec.providerID}')"
	[[ -n ${provider_id} ]] || { echo 'Missing provider id' && return 1; }

	node_rg="${provider_id#*/resourceGroups/}"
	node_rg="${node_rg%%/*}"
	[[ -n ${node_rg} ]] || { echo 'Missing resource group in provider id' && return 1; }

	aks_id="$(az aks list --subscription="${subscription}" \
		--query "[].[id,nodeResourceGroup]" \
		-o tsv 2>/dev/null | awk -v target="${node_rg}" 'tolower($2)==tolower(target){print $1; exit}' || true)"
	[[ -n ${aks_id} ]] || { echo "Missing AKS ID based on node resource group '${node_rg}' (subscription '${subscription}'). Check az account/subscription context and cluster ownership." && return 1; }

	cluster_name="$(echo "$aks_id" | $sed -E 's|.*/managedClusters/([^/]+)$|\1|I')"
	[[ -n ${cluster_name} ]] || { echo 'Missing cluster name in AKS ID' && return 1; }

	echo "AKS cluster detected: ${cluster_name}"

	if ! az aks nodepool show --subscription "${subscription}" -g "${resource_group}" --cluster-name "${cluster_name}" -n "${nodepool_name}" >/dev/null 2>&1; then
		echo "Creating nodepool '${nodepool_name}' (${vm_size}, count=${node_count}) with label hugepages=enabled..."
		az aks nodepool add \
			--subscription "${subscription}" \
			-g "${resource_group}" \
			--cluster-name "${cluster_name}" \
			-n "${nodepool_name}" \
			--node-count "${node_count}" \
			--node-vm-size "${vm_size}" \
			--labels hugepages=enabled \
			--mode User
	else
		echo "Nodepool '${nodepool_name}' already exists."
	fi

	echo "Waiting for hugepages node(s) to be Ready..."
	kubectl wait node -l hugepages=enabled --for=condition=Ready --timeout=15m || {
		echo "AKS: hugepages node(s) not ready in time. Skipping test."
		return 1
	}
}

